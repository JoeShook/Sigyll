@page "/admin/operators"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = SigyllRoles.Admin)]
@layout Sigyll.UI.Components.Layout.MainLayout

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Sigyll.Data
@using Sigyll.Common.Security
@using Sigyll.Common.Services.Audit
@using Sigyll.UI.Services

@inject UserManager<SigyllUser> UserManager
@inject Sigyll.Services.OperatorAccountService OperatorAccounts
@inject AuditTrail Audit
@inject IOperatorContext OperatorContext
@inject IToastService ToastService
@inject IDialogService DialogService

<PageTitle>Operators</PageTitle>

<FluentLabel Typo="Typography.PageTitle" Style="margin-bottom: 0.25rem;">Operators</FluentLabel>
<FluentLabel Style="opacity: 0.7; margin-bottom: 1rem;">
    CA operator accounts. There is no self-registration — accounts are created here.
    New operators should sign in, change their password, and enroll a passkey.
</FluentLabel>

<FluentStack Orientation="Orientation.Horizontal" Style="margin-bottom: 1rem;">
    <FluentButton Appearance="Appearance.Accent"
                  IconStart="@(new Icons.Regular.Size16.PersonAdd())"
                  OnClick="@(() => createDialogHidden = false)">
        New Operator
    </FluentButton>
</FluentStack>

<table class="operators-table" style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
    <thead>
        <tr style="text-align: left; border-bottom: 1px solid var(--neutral-stroke-rest);">
            <th style="padding: 0.5rem;">Email</th>
            <th style="padding: 0.5rem;">Display Name</th>
            <th style="padding: 0.5rem;">Roles</th>
            <th style="padding: 0.5rem;">Second factor</th>
            <th style="padding: 0.5rem;">Lockout</th>
            <th style="padding: 0.5rem;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in operators)
        {
            <tr style="border-bottom: 1px solid var(--neutral-stroke-divider-rest);">
                <td style="padding: 0.5rem;">@row.User.Email</td>
                <td style="padding: 0.5rem;">@row.User.DisplayName</td>
                <td style="padding: 0.5rem;">@string.Join(", ", row.Roles)</td>
                <td style="padding: 0.5rem;">@row.SecondFactor</td>
                <td style="padding: 0.5rem;">
                    @(row.User.LockoutEnd > DateTimeOffset.UtcNow ? "Locked" : "—")
                </td>
                <td style="padding: 0.5rem; text-align: right;">
                    <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small"
                                  IconStart="@(new Icons.Regular.Size16.PeopleTeam())"
                                  OnClick="@(() => ShowEditRolesDialog(row))"
                                  Disabled="@(row.User.Id == currentUserId)"
                                  title="@(row.User.Id == currentUserId ? "Another Admin must change your roles" : "Change this operator's roles")">
                        Roles
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small"
                                  IconStart="@(new Icons.Regular.Size16.Key())"
                                  OnClick="@(() => ShowSetPasswordDialog(row.User))"
                                  title="Set a new password for this operator">
                        Set Password
                    </FluentButton>
                    @if (row.User.LockoutEnd > DateTimeOffset.UtcNow)
                    {
                        <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small"
                                      IconStart="@(new Icons.Regular.Size16.LockOpen())"
                                      OnClick="@(() => UnlockAsync(row.User))"
                                      title="End this operator's lockout">
                            Unlock
                        </FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small"
                                  IconStart="@(new Icons.Regular.Size16.ShieldDismiss())"
                                  OnClick="@(() => ResetSecondFactorAsync(row.User))"
                                  Disabled="@(row.User.Id == currentUserId || row.SecondFactor == "None")"
                                  title="@(row.User.Id == currentUserId ? "Another Admin must reset your second factor" : "Remove this operator's authenticator app and passkeys; they set up a new one at next sign-in")">
                        Reset 2nd factor
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small"
                                  IconStart="@(new Icons.Regular.Size16.Delete())"
                                  OnClick="@(() => DeleteOperatorAsync(row.User))"
                                  Disabled="@(row.User.Id == currentUserId)"
                                  title="Delete this operator account">
                        Delete
                    </FluentButton>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Create operator dialog *@
<FluentDialog @bind-Hidden="@createDialogHidden" Modal="true" TrapFocus="true" Style="min-width: 420px;">
    <FluentDialogHeader>New Operator</FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 0.75rem;">
            <FluentTextField @bind-Value="newEmail" Label="Email" Style="width: 100%;" />
            <FluentTextField @bind-Value="newDisplayName" Label="Display name" Style="width: 100%;" />
            <FluentTextField @bind-Value="newPassword" Label="Initial password"
                             TextFieldType="TextFieldType.Password" Style="width: 100%;" />
            <FluentLabel Typo="Typography.Subject">Roles</FluentLabel>
            @foreach (var role in SigyllRoles.All)
            {
                <FluentCheckbox Value="@newRoles.Contains(role)"
                                ValueChanged="@(v => ToggleNewRole(role, v))"
                                Label="@role" />
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="CreateOperatorAsync"
                      Disabled="@(string.IsNullOrWhiteSpace(newEmail) || string.IsNullOrWhiteSpace(newPassword) || newRoles.Count == 0)">
            Create
        </FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => createDialogHidden = true)">Cancel</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@* Edit roles dialog *@
<FluentDialog @bind-Hidden="@editRolesDialogHidden" Modal="true" TrapFocus="true" Style="min-width: 420px;">
    <FluentDialogHeader>Roles</FluentDialogHeader>
    <FluentDialogBody>
        <p style="font-size: 0.9rem;">Roles for <code>@editRolesTarget?.Email</code>.</p>
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 0.5rem;">
            @foreach (var role in SigyllRoles.All)
            {
                <FluentCheckbox Value="@editRoles.Contains(role)"
                                ValueChanged="@(v => ToggleEditRole(role, v))"
                                Label="@role" />
            }
        </FluentStack>
        <p style="font-size: 0.8rem; opacity: 0.7; margin-top: 0.75rem;">
            KeyCustodian is the only role that can export private keys; Admin does not include it.
        </p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="SaveRolesAsync"
                      Disabled="@(editRoles.Count == 0)">
            Save
        </FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => editRolesDialogHidden = true)">Cancel</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@* Set password dialog *@
<FluentDialog @bind-Hidden="@setPasswordDialogHidden" Modal="true" TrapFocus="true" Style="min-width: 420px;">
    <FluentDialogHeader>Set Password</FluentDialogHeader>
    <FluentDialogBody>
        <p style="font-size: 0.9rem;">Set a new password for <code>@setPasswordTarget?.Email</code>.</p>
        <FluentTextField @bind-Value="setPasswordValue" Label="New password"
                         TextFieldType="TextFieldType.Password" Style="width: 100%;" />
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="SetPasswordAsync"
                      Disabled="@(string.IsNullOrWhiteSpace(setPasswordValue))">
            Set Password
        </FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => setPasswordDialogHidden = true)">Cancel</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private record OperatorRow(SigyllUser User, IList<string> Roles, string SecondFactor);

    private List<OperatorRow> operators = new();
    private string? currentUserId;

    private bool createDialogHidden = true;
    private string newEmail = string.Empty;
    private string newDisplayName = string.Empty;
    private string newPassword = string.Empty;
    private readonly HashSet<string> newRoles = new() { SigyllRoles.CaOperator };

    private bool editRolesDialogHidden = true;
    private SigyllUser? editRolesTarget;
    private readonly HashSet<string> editRoles = new();

    private bool setPasswordDialogHidden = true;
    private SigyllUser? setPasswordTarget;
    private string setPasswordValue = string.Empty;

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var auth = await AuthState;
            currentUserId = UserManager.GetUserId(auth.User);
        }
        await LoadOperatorsAsync();
    }

    private async Task LoadOperatorsAsync()
    {
        var users = await UserManager.Users.OrderBy(u => u.Email).ToListAsync();
        var rows = new List<OperatorRow>();
        foreach (var user in users)
        {
            var factors = new List<string>();
            if (await UserManager.GetTwoFactorEnabledAsync(user)) factors.Add("Authenticator app");
            var passkeys = (await UserManager.GetPasskeysAsync(user)).Count;
            if (passkeys > 0) factors.Add(passkeys == 1 ? "1 passkey" : $"{passkeys} passkeys");
            rows.Add(new OperatorRow(user, await UserManager.GetRolesAsync(user),
                factors.Count > 0 ? string.Join(", ", factors) : "None"));
        }
        operators = rows;
    }

    private void ToggleNewRole(string role, bool selected)
    {
        if (selected) newRoles.Add(role);
        else newRoles.Remove(role);
    }

    private async Task CreateOperatorAsync()
    {
        var user = new SigyllUser
        {
            UserName = newEmail.Trim(),
            Email = newEmail.Trim(),
            EmailConfirmed = true,
            DisplayName = string.IsNullOrWhiteSpace(newDisplayName) ? null : newDisplayName.Trim()
        };

        var result = await UserManager.CreateAsync(user, newPassword);
        if (!result.Succeeded)
        {
            ToastService.ShowCopyableError(string.Join("; ", result.Errors.Select(e => e.Description)));
            return;
        }

        foreach (var role in newRoles)
            await UserManager.AddToRoleAsync(user, role);
        await RecordAsync(AuditActions.OperatorCreated, user,
            $"Roles: {(newRoles.Count > 0 ? string.Join(", ", newRoles.Order()) : "none")}.");

        ToastService.ShowSuccess($"Operator '{user.Email}' created");
        createDialogHidden = true;
        newEmail = newDisplayName = newPassword = string.Empty;
        newRoles.Clear();
        newRoles.Add(SigyllRoles.CaOperator);
        await LoadOperatorsAsync();
    }

    private void ShowEditRolesDialog(OperatorRow row)
    {
        editRolesTarget = row.User;
        editRoles.Clear();
        editRoles.UnionWith(row.Roles);
        editRolesDialogHidden = false;
    }

    private void ToggleEditRole(string role, bool selected)
    {
        if (selected) editRoles.Add(role);
        else editRoles.Remove(role);
    }

    private async Task SaveRolesAsync()
    {
        if (editRolesTarget == null) return;

        // An operator never changes their own roles: granting yourself KeyCustodian, or dropping
        // your own Admin, takes a second Admin.
        if (editRolesTarget.Id == currentUserId)
        {
            ToastService.ShowWarning("Another Admin must change your roles.");
            return;
        }

        var current = await UserManager.GetRolesAsync(editRolesTarget);
        var toRemove = current.Except(editRoles).ToList();
        var toAdd = editRoles.Except(current).ToList();

        var result = IdentityResult.Success;
        if (toRemove.Count > 0)
            result = await UserManager.RemoveFromRolesAsync(editRolesTarget, toRemove);
        if (result.Succeeded && toAdd.Count > 0)
            result = await UserManager.AddToRolesAsync(editRolesTarget, toAdd);

        if (result.Succeeded)
        {
            // Rotate the security stamp so the operator's open sessions pick up the change.
            await UserManager.UpdateSecurityStampAsync(editRolesTarget);
            await RecordAsync(AuditActions.OperatorRolesChanged, editRolesTarget,
                $"Granted: {(toAdd.Count > 0 ? string.Join(", ", toAdd) : "none")}; " +
                $"removed: {(toRemove.Count > 0 ? string.Join(", ", toRemove) : "none")}.");
            ToastService.ShowSuccess($"Roles updated for '{editRolesTarget.Email}'");
            editRolesDialogHidden = true;
            await LoadOperatorsAsync();
        }
        else
        {
            ToastService.ShowCopyableError(string.Join("; ", result.Errors.Select(e => e.Description)));
        }
    }

    private async Task RecordAsync(string action, SigyllUser user, string detail) =>
        await Audit.RecordAsync(await OperatorContext.GetCurrentAsync(), action,
            AuditTarget.Operator(user.Email ?? user.UserName ?? user.Id), detail);

    private void ShowSetPasswordDialog(SigyllUser user)
    {
        setPasswordTarget = user;
        setPasswordValue = string.Empty;
        setPasswordDialogHidden = false;
    }

    private async Task SetPasswordAsync()
    {
        if (setPasswordTarget == null) return;

        var token = await UserManager.GeneratePasswordResetTokenAsync(setPasswordTarget);
        var result = await UserManager.ResetPasswordAsync(setPasswordTarget, token, setPasswordValue);

        if (result.Succeeded)
        {
            await RecordAsync(AuditActions.OperatorPasswordSet, setPasswordTarget, "Set by an Admin.");
            ToastService.ShowSuccess($"Password updated for '{setPasswordTarget.Email}'");
            setPasswordDialogHidden = true;
        }
        else
        {
            ToastService.ShowCopyableError(string.Join("; ", result.Errors.Select(e => e.Description)));
        }
    }

    private async Task UnlockAsync(SigyllUser user)
    {
        await OperatorAccounts.UnlockAsync(user);
        ToastService.ShowSuccess($"'{user.Email}' unlocked");
        await LoadOperatorsAsync();
    }

    /// <summary>For an operator who lost their authenticator or passkeys: they set up a new factor at next sign-in.</summary>
    private async Task ResetSecondFactorAsync(SigyllUser user)
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Remove the authenticator app, recovery codes and passkeys of '{user.Email}'? They are signed out now and must set up a new second factor when they next sign in.",
            "Reset", "Cancel", "Reset second factor");
        if ((await dialog.Result).Cancelled) return;

        await OperatorAccounts.ResetSecondFactorAsync(user);
        ToastService.ShowSuccess($"Second factor reset for '{user.Email}'");
        await LoadOperatorsAsync();
    }

    private async Task DeleteOperatorAsync(SigyllUser user)
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Delete operator '{user.Email}'? They will immediately lose access.",
            "Delete", "Cancel", "Confirm Delete");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        var roles = await UserManager.GetRolesAsync(user);
        var deleteResult = await UserManager.DeleteAsync(user);
        if (deleteResult.Succeeded)
        {
            await RecordAsync(AuditActions.OperatorDeleted, user,
                $"Held roles: {(roles.Count > 0 ? string.Join(", ", roles.Order()) : "none")}.");
            ToastService.ShowSuccess($"Operator '{user.Email}' deleted");
            await LoadOperatorsAsync();
        }
        else
        {
            ToastService.ShowCopyableError(string.Join("; ", deleteResult.Errors.Select(e => e.Description)));
        }
    }
}
