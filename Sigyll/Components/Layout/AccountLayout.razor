@inherits LayoutComponentBase

@* Minimal SSR layout for the /Account pages, styled to match the FluentUI app (dark theme,
   accent green). account.css implements the Identity profile's class names in Sigyll's
   design language — bootstrap is not used. Linked here (not App.razor) so it only loads on
   account pages. *@
<link rel="stylesheet" href="/css/account.css" />

<div class="account-shell">
    <header class="account-header">
        <a href="/">Sigyll</a>
        <span class="text-secondary">Certificate Authority</span>
        @* Signed-in operators land here after setting up a second factor; give them an obvious way back. *@
        <AuthorizeView>
            <a class="account-back" href="/">Back to Sigyll &rarr;</a>
        </AuthorizeView>
    </header>
    <div class="account-card">
        @Body
    </div>
</div>
