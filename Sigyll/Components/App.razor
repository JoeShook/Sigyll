<!DOCTYPE html>
<html lang="en" style="background-color: #272727; color-scheme: dark;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sigyll - PKI Management</title>
    <base href="/" />
    @* Pre-paint colours match FluentUI's dark neutral layer, so nothing flashes a different colour before the
       theme loads. Static account pages override them in account.css. *@
    <style>
        html, body { height: 100%; margin: 0; background-color: #272727; color: #e0e0e0; }
    </style>
    @if (PageRenderMode is not null)
    {
        @* FluentUI's anti-flash helper: <loading-theme> below hides the page, on a background in the saved
           theme's colour, until the Fluent web components are defined, then shows it fully styled. *@
        <script src="/_content/Microsoft.FluentUI.AspNetCore.Components/js/loading-theme.js" type="text/javascript"></script>
        @* Paint the first frame in the theme the page will open in (same rule as loading-theme.js: the saved
           mode, else the system preference), so a light-theme user doesn't see one dark frame. *@
        <script src="/js/theme-preload.js"></script>
    }
    <link rel="stylesheet" href="/css/site.css" />
    <link href="/_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" rel="stylesheet" />
    <link href="/Sigyll.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    @if (HttpContext.User.Identity?.IsAuthenticated == true)
    {
        @* Read by sigyll.js: sign out after this many idle minutes; keep the session alive while active. *@
        <meta name="sigyll-idle-minutes" content="@Session.IdleTimeout.TotalMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
    }
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    @if (PageRenderMode is not null)
    {
        <loading-theme storage-name="sigil-theme"></loading-theme>
    }
    <Routes @rendermode="PageRenderMode" />
    <script src="/_framework/blazor.web.js"></script>
    <script src="Components/Account/Shared/PasskeySubmit.razor.js" type="module"></script>
    <script src="/js/sigyll.js"></script>
</body>
</html>

@inject Sigyll.Components.Account.OperatorSessionOptions Session

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Account pages carry [ExcludeFromInteractiveRouting] and must render as static SSR —
    // a hard-wired InteractiveServer render mode would prerender them and then have the
    // interactive router reject the route as "Not found" once the circuit connects.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
