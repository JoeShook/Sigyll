@page "/requests/new"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Sigyll.Contracts
@using Sigyll.Portal.Services
@inject CatalogService Catalog
@inject RequestWorkflowService Workflow
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>New Certificate Request</PageTitle>

<FluentLabel Typo="Typography.PageTitle" Style="margin-bottom: 1rem;">Request a Certificate</FluentLabel>

@if (_catalog is null)
{
    <FluentProgressRing />
}
else if (_catalog.Templates.Count == 0)
{
    <FluentCard Style="border-left: 4px solid var(--warning, #ff9800); max-width: 720px;">
        The CA catalog is empty or unreachable. Confirm the CA core is running and reachable at the
        configured <code>Portal:CaBaseUrl</code>.
    </FluentCard>
}
else
{
    <FluentCard Style="max-width: 760px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="14">
            <FluentSelect TOption="string" Items="@_trustDomainNames" @bind-SelectedOption="_trustDomain"
                          Label="Trust domain" Style="width: 100%;" />

            <FluentSelect TOption="string" Items="@_templateNames" @bind-SelectedOption="_templateName"
                          Label="Certificate type (template)" Style="width: 100%;" />
            @if (SelectedTemplate is { } tpl)
            {
                <FluentLabel Typo="Typography.Body" Style="opacity: 0.75; margin-top: -8px;">
                    @(tpl.RequiresRaApproval
                        ? "This classification requires Registration Authority approval."
                        : tpl.AllowAutoIssue
                            ? "Eligible for automated issuance after domain validation."
                            : "Subject to policy review.")
                </FluentLabel>
            }

            <FluentTextArea @bind-Value="_csrPem" Label="CSR (PKCS#10, PEM)"
                            Style="width: 100%; min-height: 180px; font-family: monospace; font-size: 12px;"
                            Placeholder="-----BEGIN CERTIFICATE REQUEST-----" />
            <FluentButton Appearance="Appearance.Outline" OnClick="ParseCsr"
                          Disabled="@string.IsNullOrWhiteSpace(_csrPem)"
                          IconStart="@(new Icons.Regular.Size20.DocumentSearch())">Parse CSR</FluentButton>

            @if (!string.IsNullOrEmpty(_subjectDn))
            {
                <FluentTextField Value="@_subjectDn" Label="Subject (from CSR)" ReadOnly="true" Style="width: 100%;" />
            }

            <div>
                <FluentLabel Typo="Typography.Subject" Style="margin-bottom: 6px;">Subject Alternative Names</FluentLabel>
                @foreach (var san in _sans)
                {
                    <FluentStack HorizontalGap="8" Style="margin-bottom: 6px;" VerticalAlignment="VerticalAlignment.Center">
                        <FluentSelect TOption="string" Items="@_sanTypes" @bind-SelectedOption="san.Type" Style="width: 140px;" />
                        <FluentTextField @bind-Value="san.Value" Style="flex: 1;" />
                        <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => _sans.Remove(san))"
                                      IconStart="@(new Icons.Regular.Size20.Delete())" Title="Remove" />
                    </FluentStack>
                }
                <FluentButton Appearance="Appearance.Outline"
                              OnClick="@(() => _sans.Add(new ApiSanEntry { Type = "Dns" }))"
                              IconStart="@(new Icons.Regular.Size20.Add())">Add SAN</FluentButton>
            </div>

            @if (_error is not null)
            {
                <FluentCard Style="border-left: 4px solid var(--error, #e94560);">@_error</FluentCard>
            }

            <FluentButton Appearance="Appearance.Accent" OnClick="Submit" Disabled="@(_submitting || !CanSubmit)">
                @(_submitting ? "Submitting…" : "Submit request")
            </FluentButton>
        </FluentStack>
    </FluentCard>
}

@code {
    private CatalogResponse? _catalog;
    private List<string> _trustDomainNames = new();
    private List<string> _templateNames = new();
    private readonly List<string> _sanTypes = new() { "Dns", "Uri", "Email", "IpAddress" };

    private string? _trustDomain;
    private string? _templateName;
    private string _csrPem = "";
    private string _subjectDn = "";
    private readonly List<ApiSanEntry> _sans = new();
    private string? _error;
    private bool _submitting;

    private CatalogTemplate? SelectedTemplate =>
        _catalog?.Templates.FirstOrDefault(t => t.Name == _templateName);

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_trustDomain)
        && !string.IsNullOrWhiteSpace(_templateName)
        && !string.IsNullOrWhiteSpace(_csrPem);

    protected override async Task OnInitializedAsync()
    {
        _catalog = await Catalog.GetCatalogAsync();
        _trustDomainNames = _catalog.TrustDomains.Where(t => t.Enabled).Select(t => t.Name).ToList();
        _templateNames = _catalog.Templates.Select(t => t.Name).ToList();
    }

    private void ParseCsr()
    {
        _error = null;
        try
        {
            var parsed = CsrParser.Parse(_csrPem);
            _subjectDn = parsed.SubjectDn;
            _sans.Clear();
            _sans.AddRange(parsed.Sans);
        }
        catch (Exception ex)
        {
            _error = $"Could not parse CSR: {ex.Message}";
        }
    }

    private async Task Submit()
    {
        _error = null;
        _submitting = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

            if (string.IsNullOrEmpty(_subjectDn))
            {
                try { _subjectDn = CsrParser.Parse(_csrPem).SubjectDn; } catch { /* surfaced below if invalid */ }
            }

            var request = await Workflow.SubmitAsync(
                userId, organizationId: null, _trustDomain!, _templateName!, _subjectDn,
                _sans.Where(s => !string.IsNullOrWhiteSpace(s.Value)).ToList(), _csrPem);

            Nav.NavigateTo($"/requests/{request.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }
}
