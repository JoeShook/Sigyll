@page "/requests"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Sigyll.Portal.Data
@using Sigyll.Portal.Data.Entities
@inject PortalDbContext Db
@inject AuthenticationStateProvider AuthState

<PageTitle>My Requests</PageTitle>

<FluentStack VerticalAlignment="VerticalAlignment.Center" Style="margin-bottom: 1rem;">
    <FluentLabel Typo="Typography.PageTitle">My Requests</FluentLabel>
    <FluentSpacer />
    <FluentAnchor Href="requests/new" Appearance="Appearance.Accent"
                  IconStart="@(new Icons.Regular.Size20.AddCircle())">New Request</FluentAnchor>
</FluentStack>

@if (_requests is null)
{
    <FluentProgressRing />
}
else if (_requests.Count == 0)
{
    <FluentLabel Typo="Typography.Body">You have no requests yet.</FluentLabel>
}
else
{
    <FluentDataGrid Items="@_requests.AsQueryable()" GridTemplateColumns="0.5fr 2fr 1.2fr 1.2fr 1fr 1.2fr 0.6fr">
        <PropertyColumn Property="@(r => r.Id)" Title="#" Sortable="true" />
        <PropertyColumn Property="@(r => r.SubjectDn)" Title="Subject" />
        <PropertyColumn Property="@(r => r.TemplateName)" Title="Template" />
        <PropertyColumn Property="@(r => r.TrustDomainName)" Title="Trust domain" />
        <TemplateColumn Title="Status">
            <FluentBadge BackgroundColor="@StatusColor(context.Status)" Color="white">@context.Status</FluentBadge>
        </TemplateColumn>
        <TemplateColumn Title="Created">
            @context.CreatedAt.ToLocalTime().ToString("g")
        </TemplateColumn>
        <TemplateColumn Title="">
            <FluentAnchor Href="@($"requests/{context.Id}")" Appearance="Appearance.Outline">View</FluentAnchor>
        </TemplateColumn>
    </FluentDataGrid>
}

@code {
    private List<CertificateRequest>? _requests;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        _requests = await Db.CertificateRequests
            .Where(r => r.RequesterId == userId)
            .OrderByDescending(r => r.Id)
            .ToListAsync();
    }

    private static string StatusColor(RequestStatus s) => s switch
    {
        RequestStatus.Issued => "#4caf50",
        RequestStatus.Failed or RequestStatus.Rejected => "#e94560",
        RequestStatus.PendingRaApproval or RequestStatus.PendingValidation => "#ff9800",
        _ => "#888",
    };
}
