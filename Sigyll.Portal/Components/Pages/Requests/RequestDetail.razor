@page "/requests/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Sigyll.Portal.Data
@using Sigyll.Portal.Data.Entities
@using Sigyll.Portal.Services
@inject PortalDbContext Db
@inject RequestWorkflowService Workflow
@inject AuthenticationStateProvider AuthState

<PageTitle>Request @Id</PageTitle>

@if (_request is null)
{
    <FluentProgressRing />
}
else
{
    <FluentStack VerticalAlignment="VerticalAlignment.Center" Style="margin-bottom: 1rem;">
        <FluentLabel Typo="Typography.PageTitle">Request #@_request.Id</FluentLabel>
        <FluentBadge BackgroundColor="@StatusColor(_request.Status)" Color="white">@_request.Status</FluentBadge>
    </FluentStack>

    <FluentCard Style="max-width: 820px; margin-bottom: 1rem;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <div><strong>Subject:</strong> @_request.SubjectDn</div>
            <div><strong>Template:</strong> @_request.TemplateName <span style="opacity:.6;">(@_request.TrustDomainName)</span></div>
            <div><strong>Policy:</strong> @_request.PolicyDecision — @_request.PolicyReason</div>
            @if (_request.FailureReason is not null)
            {
                <div style="color: var(--error, #e94560);"><strong>Failure:</strong> @_request.FailureReason</div>
            }
        </FluentStack>
    </FluentCard>

    @if (_request.Status is RequestStatus.PendingValidation && _request.Challenges.Count > 0)
    {
        <FluentCard Style="max-width: 820px; margin-bottom: 1rem;">
            <FluentLabel Typo="Typography.Subject" Style="margin-bottom: 8px;">Domain validation (http-01)</FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="margin-bottom: 10px;">
                For each identifier, serve the exact content at the URL shown, then click Verify &amp; issue.
            </FluentLabel>
            @foreach (var c in _request.Challenges)
            {
                <div style="margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid var(--neutral-stroke-rest);">
                    <div>
                        <strong>@c.Identifier</strong>
                        <FluentBadge BackgroundColor="@(c.Status == DomainValidationStatus.Valid ? "#4caf50" : "#888")" Color="white">@c.Status</FluentBadge>
                    </div>
                    <div style="font-size: .85rem;">URL: <code>@DomainValidationService.ChallengeUrl(c)</code></div>
                    <div style="font-size: .85rem;">Content: <code>@c.KeyAuthorization</code></div>
                </div>
            }
            <FluentButton Appearance="Appearance.Accent" OnClick="VerifyAndIssue" Disabled="@_busy">
                @(_busy ? "Checking…" : "Verify & issue")
            </FluentButton>
        </FluentCard>
    }

    @if (_request.Status == RequestStatus.PendingRaApproval)
    {
        <FluentCard Style="max-width: 820px; margin-bottom: 1rem; border-left: 4px solid var(--accent-fill-rest);">
            Awaiting Registration Authority approval.
        </FluentCard>
    }

    @if (_request.Status == RequestStatus.Issued)
    {
        <FluentCard Style="max-width: 820px; margin-bottom: 1rem;">
            <FluentLabel Typo="Typography.Subject" Style="margin-bottom: 8px;">Issued certificate</FluentLabel>
            <div style="font-size: .9rem; margin-bottom: 10px;">
                Serial: <code>@_request.SerialNumber</code><br />Thumbprint: <code>@_request.Thumbprint</code>
            </div>
            <FluentStack HorizontalGap="10">
                <FluentAnchor Href="@($"requests/{_request.Id}/download/cert")" Target="_blank" Appearance="Appearance.Accent"
                              IconStart="@(new Icons.Regular.Size20.ArrowDownload())">Certificate (PEM)</FluentAnchor>
                <FluentAnchor Href="@($"requests/{_request.Id}/download/chain")" Target="_blank" Appearance="Appearance.Outline"
                              IconStart="@(new Icons.Regular.Size20.ArrowDownload())">Chain (PEM)</FluentAnchor>
            </FluentStack>
        </FluentCard>
    }

    <FluentLabel Typo="Typography.Subject" Style="margin-bottom: 6px;">History</FluentLabel>
    <FluentCard Style="max-width: 820px;">
        @foreach (var e in _request.Events.OrderBy(e => e.Id))
        {
            <FluentStack VerticalAlignment="VerticalAlignment.Center" Style="padding: 4px 0; border-bottom: 1px solid var(--neutral-stroke-rest);">
                <span><strong>@e.EventType</strong> — @e.Detail <span style="opacity:.6;">(@e.Actor)</span></span>
                <FluentSpacer />
                <span style="opacity:.6; font-size:.8rem;">@e.At.ToLocalTime().ToString("g")</span>
            </FluentStack>
        }
    </FluentCard>
}

@code {
    [Parameter] public int Id { get; set; }
    private CertificateRequest? _request;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        _request = await Db.CertificateRequests
            .Include(r => r.Challenges)
            .Include(r => r.Events)
            .FirstOrDefaultAsync(r => r.Id == Id && r.RequesterId == userId);
    }

    private async Task VerifyAndIssue()
    {
        _busy = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
            await Workflow.VerifyAndIssueAsync(Id, userId);
            await Load();
        }
        finally { _busy = false; }
    }

    private static string StatusColor(RequestStatus s) => s switch
    {
        RequestStatus.Issued => "#4caf50",
        RequestStatus.Failed or RequestStatus.Rejected => "#e94560",
        RequestStatus.PendingRaApproval or RequestStatus.PendingValidation => "#ff9800",
        _ => "#888",
    };
}
