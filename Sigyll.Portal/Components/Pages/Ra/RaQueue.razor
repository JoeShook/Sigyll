@page "/ra/queue"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "RA,PortalAdmin")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Sigyll.Portal.Data
@using Sigyll.Portal.Data.Entities
@using Sigyll.Portal.Services
@inject PortalDbContext Db
@inject RequestWorkflowService Workflow
@inject AuthenticationStateProvider AuthState

<PageTitle>RA Queue</PageTitle>
<FluentLabel Typo="Typography.PageTitle" Style="margin-bottom: 1rem;">Registration Authority — Pending Requests</FluentLabel>

@if (_message is not null)
{
    <FluentCard Style="margin-bottom: 1rem; border-left: 4px solid var(--accent-fill-rest);">@_message</FluentCard>
}

@if (_pending is null)
{
    <FluentProgressRing />
}
else if (_pending.Count == 0)
{
    <FluentLabel Typo="Typography.Body">No requests are awaiting approval.</FluentLabel>
}
else
{
    <FluentDataGrid Items="@_pending.AsQueryable()" GridTemplateColumns="0.4fr 1.6fr 1fr 1fr 1.4fr 2fr">
        <PropertyColumn Property="@(r => r.Id)" Title="#" />
        <PropertyColumn Property="@(r => r.SubjectDn)" Title="Subject" />
        <PropertyColumn Property="@(r => r.TemplateName)" Title="Template" />
        <PropertyColumn Property="@(r => r.TrustDomainName)" Title="Trust domain" />
        <TemplateColumn Title="Policy">
            <span style="font-size: .85rem; opacity: .8;">@context.PolicyReason</span>
        </TemplateColumn>
        <TemplateColumn Title="Decision">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                <FluentTextField @bind-Value="_reasons[context.Id]" Placeholder="reason" Style="width: 100%;" />
                <FluentStack HorizontalGap="6">
                    <FluentButton Appearance="Appearance.Accent" Disabled="@_busy" OnClick="@(() => Approve(context.Id))">Approve</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" Disabled="@_busy" OnClick="@(() => Reject(context.Id))">Reject</FluentButton>
                </FluentStack>
            </FluentStack>
        </TemplateColumn>
    </FluentDataGrid>
}

@code {
    private List<CertificateRequest>? _pending;
    private readonly Dictionary<int, string> _reasons = new();
    private bool _busy;
    private string? _message;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _pending = await Db.CertificateRequests
            .Where(r => r.Status == RequestStatus.PendingRaApproval)
            .OrderBy(r => r.Id)
            .ToListAsync();
        foreach (var r in _pending)
            _reasons.TryAdd(r.Id, "");
    }

    private async Task<string> RaUserId()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "ra";
    }

    private async Task Approve(int id)
    {
        _busy = true;
        try
        {
            var result = await Workflow.ApproveAsync(id, await RaUserId(), Reason(id));
            _message = result.Status == RequestStatus.Issued
                ? $"Request #{id} approved and issued (serial {result.SerialNumber})."
                : $"Request #{id} approved but issuance reported: {result.FailureReason ?? result.Status.ToString()}.";
            await Load();
        }
        finally { _busy = false; }
    }

    private async Task Reject(int id)
    {
        _busy = true;
        try
        {
            await Workflow.RejectAsync(id, await RaUserId(), Reason(id));
            _message = $"Request #{id} rejected.";
            await Load();
        }
        finally { _busy = false; }
    }

    private string Reason(int id) =>
        _reasons.TryGetValue(id, out var r) && !string.IsNullOrWhiteSpace(r) ? r : "(no reason given)";
}
