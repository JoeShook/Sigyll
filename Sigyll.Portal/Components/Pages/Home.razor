@page "/"

<PageTitle>Sigyll Portal</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">Sigyll Certificate Request Portal</FluentLabel>

    <FluentLabel Typo="Typography.Body" Style="max-width: 680px;">
        Request and manage certificates issued by the Sigyll CA. Sign in with a passkey, submit a
        CSR, and either complete automated domain validation (for TLS server certificates) or have a
        Registration Authority review your request.
    </FluentLabel>

    <AuthorizeView>
        <Authorized>
            <FluentStack HorizontalGap="12">
                <FluentAnchor Href="requests/new" Appearance="Appearance.Accent"
                              IconStart="@(new Icons.Regular.Size20.AddCircle())">Request a certificate</FluentAnchor>
                <FluentAnchor Href="requests" Appearance="Appearance.Outline">View my requests</FluentAnchor>
            </FluentStack>
        </Authorized>
        <NotAuthorized>
            <FluentStack HorizontalGap="12">
                <FluentAnchor Href="Account/Login" Appearance="Appearance.Accent">Sign in</FluentAnchor>
                <FluentAnchor Href="Account/Register" Appearance="Appearance.Outline">Create an account</FluentAnchor>
            </FluentStack>
        </NotAuthorized>
    </AuthorizeView>
</FluentStack>
