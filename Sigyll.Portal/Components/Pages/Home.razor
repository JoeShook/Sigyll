@page "/"

<PageTitle>Sigyll Portal</PageTitle>

<h1>Sigyll Certificate Request Portal</h1>

<p class="lead">
    Request and manage certificates issued by the Sigyll CA. Sign in with a passkey, submit a CSR,
    and either complete automated domain validation (for TLS server certificates) or have a
    Registration Authority review your request.
</p>

<AuthorizeView>
    <Authorized>
        <a class="btn btn-primary" href="requests/new">Request a certificate</a>
        <a class="btn btn-outline-secondary" href="requests">View my requests</a>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-primary" href="Account/Login">Sign in</a>
        <a class="btn btn-outline-secondary" href="Account/Register">Create an account</a>
    </NotAuthorized>
</AuthorizeView>
