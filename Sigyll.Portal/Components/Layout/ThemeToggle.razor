@* Interactive island: applies the persisted Fluent theme app-wide and toggles dark/light.
   Rendered InteractiveServer so the toggle works even on the static Identity pages. *@
@rendermode InteractiveServer

<FluentDesignTheme @bind-Mode="_mode" CustomColor="#2d6a4f" StorageName="sigyll-portal-theme" />
<FluentButton Appearance="Appearance.Stealth" OnClick="Toggle"
              Title="@(_mode == DesignThemeModes.Dark ? "Switch to light mode" : "Switch to dark mode")"
              IconStart="@(_mode == DesignThemeModes.Dark
                  ? new Icons.Regular.Size20.WeatherSunny()
                  : (Icon)new Icons.Regular.Size20.WeatherMoon())" />

@code {
    private DesignThemeModes _mode = DesignThemeModes.Dark;

    private void Toggle() =>
        _mode = _mode == DesignThemeModes.Dark ? DesignThemeModes.Light : DesignThemeModes.Dark;
}
