<Project Sdk="Microsoft.NET.Sdk">

  <!-- Receives PKCS #11 calls from the relay client library over TCP and passes them to a real PKCS #11 library. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sigyll-pkcs11-relay-server</AssemblyName>
    <RootNamespace>Sigyll.Pkcs11Relay</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <PackageReference Include="Pkcs11Interop" Version="5.3.0" />
  </ItemGroup>

</Project>
