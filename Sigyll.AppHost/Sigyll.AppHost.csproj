<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);ASPIRECERTIFICATES001</NoWarn>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>sigyll-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <ProjectReference Include="..\Sigyll.Vault.Hosting\Sigyll.Vault.Hosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
