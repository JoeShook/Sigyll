<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);ASPIRECERTIFICATES001</NoWarn>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>sigyll-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <ProjectReference Include="..\Sigyll.Vault.Hosting\Sigyll.Vault.Hosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sigyll\Sigyll.csproj" />
    <ProjectReference Include="..\Sigyll.Certificate.Server\Sigyll.Certificate.Server.csproj" />
    <ProjectReference Include="..\Sigyll.Portal\Sigyll.Portal.csproj" />
  </ItemGroup>

</Project>
