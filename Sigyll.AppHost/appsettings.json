{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  // The PostgreSQL container this AppHost creates, or reuses when one with the same name and spec is already
  // running. Override these in user secrets (UserSecretsId sigyll-apphost) to share a Postgres you run for
  // other projects; see dist/AlloyDB/README.md. Parameters:postgres-password must then be that container's password.
  "Postgres": {
    "ContainerName": "sigyll-postgres",
    "DataVolume": "sigyll-postgres-data",
    "ImageTag": "17.6",
    // Optional. When other AppHosts share the container and stamp it with their Aspire version in an
    // environment variable, set that variable's name here so this AppHost stamps it identically and refuses to
    // recreate a container that belongs to a newer Aspire version.
    "AspireVersionVariable": ""
  }
}
