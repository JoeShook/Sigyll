<Project>

  <!--
    Standalone Sigyll repo settings.
    Ported from udap-dotnet's Common.props (inherited before this repo was extracted).
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- MLDsa, SlhDsa and CompositeMLDsa are still marked experimental (SYSLIB5006). Sigyll calls them on purpose. -->
    <NoWarn>$(NoWarn);SYSLIB5006</NoWarn>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/JoeShook/Sigyll</RepositoryUrl>
  </PropertyGroup>

</Project>
