@page "/jobs"
@using Sigyll.Common.Data
@using Sigyll.Common.Services.Jobs

<PageTitle>Sigyll - Jobs</PageTitle>

<FluentLabel Typo="Typography.PageTitle">Jobs</FluentLabel>

@if (isLoading)
{
    <FluentProgressRing Style="margin: 2rem auto; display: block;" />
}
else
{
    @* --- Recurring Jobs --- *@
    <FluentCard Style="margin-top: 1rem;">
        <FluentLabel Typo="Typography.Subject">Recurring Jobs</FluentLabel>

        @if (recurringJobs.Count == 0)
        {
            <p style="opacity: 0.6; margin-top: 0.5rem;">No recurring jobs registered.</p>
        }
        else
        {
            <FluentDataGrid Items="@recurringJobs.AsQueryable()" Style="margin-top: 0.5rem;">
                <PropertyColumn Property="@(j => j.JobId)" Title="Job" />
                <TemplateColumn Title="Schedule (Cron)">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 0.5rem;">
                        <FluentTextField @bind-Value="@context.EditableCron" ReadOnly="@(!Access.CanAdminister)" Style="width: 160px; font-family: monospace;" />
                        @if (context.EditableCron != context.OriginalCron)
                        {
                            <FluentButton Appearance="Appearance.Accent" OnClick="@(() => SaveCron(context))">Save</FluentButton>
                        }
                    </FluentStack>
                    @if (context.CronError != null)
                    {
                        <div style="color: var(--error); font-size: 0.8rem; margin-top: 0.25rem;">@context.CronError</div>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Last Run">
                    @When(context.LastRunAt)
                    @if (context.LastDurationMs is { } ms)
                    {
                        <span style="opacity: 0.6;"> (@(ms) ms)</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Result">
                    @if (context.LastResult == "Succeeded")
                    {
                        <FluentBadge Appearance="Appearance.Accent" BackgroundColor="#2e7d32" Color="white">Succeeded</FluentBadge>
                    }
                    else if (context.LastResult == "Failed")
                    {
                        <FluentBadge BackgroundColor="#c62828" Color="white" title="@context.LastError">Failed</FluentBadge>
                        <div style="font-size: 0.8rem; white-space: normal;">@context.LastError</div>
                    }
                    else
                    {
                        <span style="opacity: 0.6;">Not run yet</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Next Run">@When(context.NextRunAt)</TemplateColumn>
                <TemplateColumn Title="Actions">
                    <FluentButton Appearance="Appearance.Outline" Disabled="@(!Access.CanOperate)" OnClick="@(() => TriggerJob(context))">Run Now</FluentButton>
                </TemplateColumn>
            </FluentDataGrid>

            <div style="margin-top: 0.75rem; opacity: 0.6; font-size: 0.85rem;">
                <strong>Cron examples:</strong>
                <code>*/5 * * * *</code> (every 5 min) &nbsp;
                <code>0 * * * *</code> (hourly) &nbsp;
                <code>0 */6 * * *</code> (every 6 hrs) &nbsp;
                <code>0 0 * * *</code> (daily)
            </div>
        }
    </FluentCard>

    @* --- CRL Status grouped by TrustDomain --- *@
    <FluentLabel Typo="Typography.Subject" Style="margin-top: 1rem;">CRL Auto-Renewal Status</FluentLabel>

    @if (crlStatuses.Count == 0)
    {
        <FluentCard Style="margin-top: 0.5rem;">
            <p style="opacity: 0.6;">No CA certificates with signing keys found. Import or create a CA to enable CRL generation.</p>
        </FluentCard>
    }
    else
    {
        @foreach (var group in crlStatusesByTrustDomain)
        {
            <FluentCard Style="margin-top: 0.5rem;">
                <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@group.Key</FluentLabel>
                <FluentDataGrid Items="@group.Value.AsQueryable()" Style="margin-top: 0.25rem;">
                    <PropertyColumn Property="@(s => s.CaName)" Title="CA" />
                    <PropertyColumn Property="@(s => s.LatestCrlNumber)" Title="CRL #" />
                    <TemplateColumn Title="Next Update">
                        @if (context.HasCrl)
                        {
                            @TimeDisplay.FormatMedium(context.NextUpdate)
                        }
                        else
                        {
                            <span style="opacity: 0.5;">No CRL</span>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Status">
                        @if (context.NeedsRenewal)
                        {
                            <FluentBadge Appearance="Appearance.Accent" BackgroundColor="#e65100" Color="white">Renewal Due</FluentBadge>
                        }
                        else
                        {
                            <FluentBadge Appearance="Appearance.Accent" BackgroundColor="#2d6a4f" Color="white">Current</FluentBadge>
                        }
                    </TemplateColumn>
                    <PropertyColumn Property="@(s => s.RevokedCount)" Title="Revocations" />
                    <TemplateColumn Title="Actions">
                        <FluentButton Appearance="Appearance.Outline"
                                      Disabled="@(context.IsGenerating || !Access.CanOperate)"
                                      OnClick="@(() => GenerateCrl(context))">
                            @(context.HasCrl ? "Regenerate CRL" : "Generate CRL")
                        </FluentButton>
                    </TemplateColumn>
                </FluentDataGrid>
            </FluentCard>
        }
    }
}
