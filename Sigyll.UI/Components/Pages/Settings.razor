@page "/admin/settings"
@page "/admin/settings/{Section}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = SigyllRoles.Admin)]

<PageTitle>Sigyll - Settings</PageTitle>

<FluentLabel Typo="Typography.PageTitle">Settings</FluentLabel>

<div class="settings-layout">
    <nav class="settings-nav" aria-label="Settings sections">
        @foreach (var section in Sections)
        {
            <FluentAnchor Href="@($"/admin/settings/{section.Id}")"
                          Appearance="@(section == Current ? Appearance.Accent : Appearance.Stealth)"
                          IconStart="@section.Icon"
                          title="@section.Summary">
                @section.Title
            </FluentAnchor>
        }
    </nav>
    <div class="settings-content">
        @if (Current == null)
        {
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                There's no settings section called "@Section".
            </FluentMessageBar>
        }
        else
        {
            <DynamicComponent Type="@Current.Component" @key="Current.Id" />
        }
    </div>
</div>

<style>
    .settings-layout { display: flex; gap: 1.5rem; margin-top: 1rem; align-items: flex-start; }
    .settings-nav { display: flex; flex-direction: column; gap: 0.25rem; min-width: 200px; position: sticky; top: 0; }
    .settings-nav fluent-anchor::part(control) { justify-content: flex-start; width: 100%; }
    .settings-content { flex: 1; min-width: 0; max-width: 900px; }
    @@media (max-width: 760px) {
        .settings-layout { flex-direction: column; }
        .settings-nav { flex-direction: row; flex-wrap: wrap; position: static; }
    }
</style>
