@page "/admin/settings"
@page "/admin/settings/{Section}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = SigyllRoles.Admin)]
@using Sigyll.UI.Components.SettingsSections

<PageTitle>Sigyll - Settings</PageTitle>

<FluentLabel Typo="Typography.PageTitle">Settings</FluentLabel>

@if (!string.IsNullOrEmpty(Section) && Sections.All(s => !IsOpen(s)))
{
    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false" Style="margin-top: 1rem;">
        There's no settings card called "@Section".
    </FluentMessageBar>
}

<div class="settings-grid">
    @foreach (var section in Sections)
    {
        <DynamicComponent Type="@section.Component" @key="section.Id"
                          Parameters="@(new Dictionary<string, object> { [nameof(SettingsCard.Expanded)] = IsOpen(section) })" />
    }
</div>

<style>
    .settings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1rem; margin-top: 1rem; align-items: start; }
    .settings-grid .settings-card-open { grid-column: 1 / -1; }
    .settings-card-header { display: flex; align-items: center; gap: 0.5rem; }
    .settings-card-summary { font-size: 0.85rem; opacity: 0.8; margin: 0.5rem 0 0; }
</style>
