@* Backs up a whole trust domain to Vault KV: every certificate's .cer and, when asked, each CA's latest CRL and
   (for a KeyCustodian) the P12 files, at the same paths single exports use. Afterwards it lists the secrets in the
   trust domain's folder that no certificate uses any more, for the operator to remove. *@

@using Sigyll.Common.Services.Export
@inject VaultExportService VaultExport
@inject VaultTokenCache TokenCache
@inject IToastService ToastService

<FluentDialog @bind-Hidden="@hidden" Modal="true" TrapFocus="true" Style="min-width: 600px; position: relative;">
    <div class="sigil-resize-handle"></div>
    <FluentDialogHeader>Back up to Vault</FluentDialogHeader>
    <FluentDialogBody>
        @if (plan == null)
        {
            @if (error != null)
            {
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@error</FluentMessageBar>
            }
            else
            {
                <FluentProgressRing />
            }
        }
        else if (result != null)
        {
            <FluentMessageBar Intent="@(result.Failures.Count == 0 ? MessageIntent.Success : MessageIntent.Warning)" AllowDismiss="false">
                Wrote @result.SecretsWritten of @result.SecretsPlanned secrets under <code>@result.Mount/@result.Root</code>.
                @if (result.SecretsUnchanged > 0)
                {
                    <span> @result.SecretsUnchanged already held the same files and were left as they were.</span>
                }
            </FluentMessageBar>
            @if (result.Failures.Count > 0)
            {
                <ul style="font-size: 0.8rem; margin-top: 0.75rem;">
                    @foreach (var failure in result.Failures)
                    {
                        <li style="word-break: break-all;">@failure</li>
                    }
                </ul>
            }

            <div style="margin-top: 1rem;">
                <FluentLabel Weight="FontWeight.Bold">Secrets no certificate uses</FluentLabel>
                @if (result.Orphans == null)
                {
                    <p style="font-size: 0.85rem; opacity: 0.8; margin: 0.25rem 0 0;">@result.OrphanCheckError</p>
                }
                else if (orphans.Count == 0)
                {
                    <p style="font-size: 0.85rem; opacity: 0.8; margin: 0.25rem 0 0;">
                        @(removedOrphans.Count > 0 ? "No others" : "None") under <code>@result.Root</code>.
                    </p>
                }
                else
                {
                    <p style="font-size: 0.8rem; opacity: 0.7; margin: 0.25rem 0 0.5rem;">
                        These secrets are in the trust domain's folder but belong to none of its certificates, for
                        example one that was deleted or moved. Removing a secret deletes it from Vault for good, with
                        all its versions.
                    </p>
                    <div style="max-height: 240px; overflow-y: auto; border: 1px solid var(--neutral-stroke-rest); border-radius: 4px; padding: 0 0.5rem;">
                        @foreach (var orphan in orphans)
                        {
                            <div style="display: flex; align-items: flex-start; gap: 0.5rem; padding: 0.35rem 0; border-bottom: 1px solid var(--neutral-stroke-divider-rest);">
                                <FluentCheckbox Value="@selectedOrphans.Contains(orphan.Path)"
                                                ValueChanged="@((bool v) => ToggleOrphan(orphan.Path, v))"
                                                Disabled="@isBusy" aria-label="@($"Remove {orphan.Path}")" />
                                <div style="min-width: 0;">
                                    <code style="word-break: break-all;">@orphan.Path[(result.Root.Length + 1)..]</code>
                                    <div style="font-size: 0.75rem; opacity: 0.7;">
                                        @(orphan.Fields.Count == 0 ? "No current version (its latest version was deleted)" : string.Join(", ", orphan.Fields))
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (EffectiveToken == null)
                    {
                        <FluentTextField @bind-Value="token" TextFieldType="TextFieldType.Password" Immediate="true"
                                         Label="Vault token" Style="width: 100%; margin-top: 0.5rem;" />
                    }
                    @if (confirmingRemoval)
                    {
                        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false" Style="margin-top: 0.5rem;">
                            Delete @selectedOrphans.Count @(selectedOrphans.Count == 1 ? "secret" : "secrets") from Vault for good? This can't be undone.
                            <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                                <FluentButton Appearance="Appearance.Accent" OnClick="RemoveSelectedAsync" Loading="@isBusy" Disabled="@isBusy">Remove</FluentButton>
                                <FluentButton Appearance="Appearance.Outline" OnClick="@(() => confirmingRemoval = false)" Disabled="@isBusy">Cancel</FluentButton>
                            </div>
                        </FluentMessageBar>
                    }
                    else
                    {
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 0.5rem; margin-top: 0.5rem;">
                            <FluentButton Appearance="Appearance.Outline" OnClick="@(() => confirmingRemoval = true)"
                                          Disabled="@(isBusy || selectedOrphans.Count == 0 || string.IsNullOrWhiteSpace(EffectiveToken))">
                                Remove selected from Vault
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Lightweight" OnClick="SelectAllOrphans" Disabled="@isBusy">
                                @(selectedOrphans.Count == orphans.Count ? "Select none" : "Select all")
                            </FluentButton>
                        </FluentStack>
                    }
                }
                @if (removedOrphans.Count > 0)
                {
                    <details style="font-size: 0.8rem; margin-top: 0.5rem;">
                        <summary>Removed @removedOrphans.Count @(removedOrphans.Count == 1 ? "secret" : "secrets")</summary>
                        @foreach (var path in removedOrphans)
                        {
                            <div style="word-break: break-all; opacity: 0.8;"><code>@path</code></div>
                        }
                    </details>
                }
                @if (removalFailures.Count > 0)
                {
                    <ul style="font-size: 0.8rem; margin-top: 0.5rem;">
                        @foreach (var failure in removalFailures)
                        {
                            <li style="word-break: break-all;">@failure</li>
                        }
                    </ul>
                }
            </div>

            @if (error != null)
            {
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false" Style="margin-top: 0.75rem;">@error</FluentMessageBar>
            }

            <p style="font-size: 0.8rem; opacity: 0.7; margin-top: 0.75rem;">
                Browse it with <code>vault kv list -mount=@result.Mount @result.Root</code>.
            </p>
        }
        else
        {
            <p style="font-size: 0.9rem; margin-top: 0;">
                Back up trust domain <b>@plan.TrustDomainName</b> to <code>@plan.Address</code>, one secret per
                certificate, mirroring its hierarchy. Each secret keeps any fields it already has.
            </p>

            <FluentCheckbox Value="@options.IncludeKeys" ValueChanged="@((bool v) => SetOptionsAsync(options with { IncludeKeys = v }))"
                            Disabled="@(!CanExportKeys || isBusy)"
                            Label="Include private keys (P12 files, with their passwords)" />
            <div style="font-size: 0.8rem; opacity: 0.7; margin: 0.25rem 0 0 1.75rem;">
                @if (CanExportKeys)
                {
                    <span>For development and lab CAs. Keys held in an HSM, Vault Transit or KMS can't be exported.</span>
                }
                else
                {
                    <span>Needs the KeyCustodian role.</span>
                }
            </div>
            @if (options.IncludeKeys)
            {
                <FluentCheckbox Value="@options.ChainInP12" ValueChanged="@((bool v) => SetOptionsAsync(options with { ChainInP12 = v }))"
                                Disabled="@isBusy" Style="margin: 0.5rem 0 0 1.75rem;"
                                Label="Include the certificate chain in each P12 (name-chain.p12)" />
            }
            <FluentCheckbox Value="@options.IncludeCrls" ValueChanged="@((bool v) => SetOptionsAsync(options with { IncludeCrls = v }))"
                            Disabled="@isBusy" Style="margin-top: 0.5rem;"
                            Label="Include each CA's latest CRL" />

            <div style="margin-top: 0.75rem; font-size: 0.85rem;">
                <div style="opacity: 0.7;">Destination</div>
                <code style="word-break: break-all;">@plan.Mount/@(plan.Namespace ?? (string.IsNullOrWhiteSpace(chosenNamespace) ? "<namespace>" : chosenNamespace.Trim().Trim('/')))/@VaultExportService.Slug(plan.TrustDomainName)/…</code>
                <div style="margin-top: 0.25rem;">
                    @plan.CertificateCount certificates@(plan.Options.IncludeCrls ? $", {plan.CrlCount} CRLs" : "")@(plan.Options.IncludeKeys ? $", {plan.KeyCount} key files" : "")
                </div>
                @if (plan.Options.IncludeKeys && plan.CertificateOnly.Count > 0)
                {
                    <details style="margin-top: 0.25rem;">
                        <summary>@plan.CertificateOnly.Count without a key Sigyll holds (certificate only)</summary>
                        <div style="opacity: 0.8;">@string.Join(", ", plan.CertificateOnly)</div>
                    </details>
                }
                @if (plan.Excluded.Count > 0)
                {
                    <details style="margin-top: 0.25rem;">
                        <summary>@plan.Excluded.Count left out by an operator</summary>
                        <div style="opacity: 0.8;">@string.Join(", ", plan.Excluded)</div>
                    </details>
                }
                @if (plan.Superseded.Count > 0)
                {
                    <details style="margin-top: 0.25rem;">
                        <summary>@plan.Superseded.Count earlier generations of renewed certificates left out</summary>
                        <div style="opacity: 0.8;">
                            A renewal shares its predecessor's secret, so the newest generation is written; Vault's
                            version history keeps what earlier exports wrote. @string.Join(", ", plan.Superseded)
                        </div>
                    </details>
                }
            </div>

            @if (plan.Namespace == null)
            {
                <div style="margin-top: 0.75rem;">
                    <FluentLabel Weight="FontWeight.Bold">Namespace for trust domain @plan.TrustDomainName</FluentLabel>
                    <p style="font-size: 0.8rem; opacity: 0.7; margin: 0.25rem 0 0.5rem;">
                        This is the first export to Vault for this trust domain. Its certificates will go under this
                        folder of the <code>@plan.Mount</code> mount from now on; only an Admin can change it later.
                    </p>
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 0.5rem;">
                        <FluentTextField @bind-Value="chosenNamespace" Immediate="true"
                                         Placeholder="e.g. team-a" Style="width: 240px; font-family: monospace;" />
                        <FluentButton Appearance="Appearance.Outline" OnClick="ListNamespacesAsync"
                                      Disabled="@(isBusy || string.IsNullOrWhiteSpace(EffectiveToken))"
                                      title="List the folders your token can see at the top of the mount">
                            List namespaces
                        </FluentButton>
                    </FluentStack>
                    @if (listedNamespaces != null)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" Style="gap: 0.25rem; margin-top: 0.5rem;">
                            @if (listedNamespaces.Count == 0)
                            {
                                <span style="font-size: 0.8rem; opacity: 0.7;">Your token can't list the mount; type the namespace.</span>
                            }
                            @foreach (var ns in listedNamespaces)
                            {
                                <FluentButton Appearance="@(ns == chosenNamespace ? Appearance.Accent : Appearance.Lightweight)"
                                              OnClick="@(() => chosenNamespace = ns)">@ns</FluentButton>
                            }
                        </FluentStack>
                    }
                </div>
            }

            <div style="margin-top: 0.75rem;">
                @if (TokenCache.Token == null)
                {
                    <FluentTextField @bind-Value="token" TextFieldType="TextFieldType.Password" Immediate="true"
                                     Label="Vault token" Style="width: 100%;" />
                    <div style="font-size: 0.8rem; opacity: 0.7; margin-top: 0.25rem;">
                        In the Vault UI, open the user menu and click <b>Copy token</b>. Sigyll keeps it in memory for
                        this browser session only.
                    </div>
                }
                else
                {
                    <span style="font-size: 0.85rem;">Using the Vault token you entered earlier in this session.</span>
                    <FluentButton Appearance="Appearance.Lightweight" OnClick="ForgetToken" Disabled="@isBusy">Forget it</FluentButton>
                }
            </div>

            @if (isBusy)
            {
                <div style="margin-top: 0.75rem; font-size: 0.85rem;">
                    <FluentProgress Min="0" Max="@plan.Secrets.Count" Value="@done" />
                    @done of @plan.Secrets.Count secrets
                </div>
            }

            @if (error != null)
            {
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false" Style="margin-top: 0.75rem;">@error</FluentMessageBar>
            }
        }
    </FluentDialogBody>
    <FluentDialogFooter>
        @if (plan != null && result == null)
        {
            <FluentButton Appearance="Appearance.Accent" OnClick="BackupAsync" Loading="@isBusy"
                          Disabled="@(isBusy || plan.Secrets.Count == 0 || string.IsNullOrWhiteSpace(EffectiveToken) || (plan.Namespace == null && string.IsNullOrWhiteSpace(chosenNamespace)))">
                Back up
            </FluentButton>
        }
        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => hidden = true)" Disabled="@isBusy">@(result != null ? "Close" : "Cancel")</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private bool hidden = true;
    private bool isBusy;
    private int trustDomainId;
    private VaultBackupOptions options = new();
    private VaultBackupPlan? plan;
    private VaultBackupResult? result;
    private string? chosenNamespace;
    private List<string>? listedNamespaces;
    private string? token;
    private string? error;
    private int done;
    private List<VaultOrphan> orphans = [];
    private readonly HashSet<string> selectedOrphans = new();
    private List<string> removedOrphans = [];
    private List<string> removalFailures = [];
    private bool confirmingRemoval;

    /// <summary>Whether the operator may include P12 files (the KeyCustodian role).</summary>
    [Parameter] public bool CanExportKeys { get; set; }

    /// <summary>Raised after a backup wrote at least one secret.</summary>
    [Parameter] public EventCallback OnBackedUp { get; set; }

    private string? EffectiveToken => TokenCache.Token ?? (string.IsNullOrWhiteSpace(token) ? null : token);

    /// <summary>Opens the dialog for the trust domain <paramref name="id"/>.</summary>
    public async Task ShowAsync(int id)
    {
        trustDomainId = id;
        options = new();
        plan = null;
        result = null;
        chosenNamespace = null;
        listedNamespaces = null;
        token = null;
        error = null;
        done = 0;
        orphans = [];
        selectedOrphans.Clear();
        removedOrphans = [];
        removalFailures = [];
        confirmingRemoval = false;
        hidden = false;
        StateHasChanged();
        await LoadPlanAsync();
    }

    private async Task LoadPlanAsync()
    {
        try
        {
            plan = await VaultExport.PlanBackupAsync(trustDomainId, options);
            error = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            plan = null;
            error = ex.Message;
        }
        StateHasChanged();
    }

    private async Task SetOptionsAsync(VaultBackupOptions value)
    {
        options = value;
        await LoadPlanAsync();
    }

    private async Task ListNamespacesAsync()
    {
        isBusy = true;
        try
        {
            listedNamespaces = (await VaultExport.ListNamespacesAsync(EffectiveToken!)).ToList();
            error = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            error = $"Couldn't reach Vault: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task BackupAsync()
    {
        isBusy = true;
        error = null;
        done = 0;
        try
        {
            var usedToken = EffectiveToken!;
            // Progress<T> posts back to the circuit's context, so each report can re-render.
            var progress = new Progress<int>(n =>
            {
                done = n;
                StateHasChanged();
            });
            result = await VaultExport.BackupAsync(trustDomainId, usedToken, options,
                plan!.Namespace == null ? chosenNamespace : null, progress);
            TokenCache.Save(usedToken);
            token = null;
            orphans = result.Orphans?.ToList() ?? [];
            if (result.SecretsWritten + result.SecretsUnchanged > 0)
            {
                ToastService.ShowSuccess($"Backed up {plan.TrustDomainName} to Vault {result.Mount}/{result.Root} " +
                                         $"({result.SecretsWritten} written, {result.SecretsUnchanged} unchanged).");
                await OnBackedUp.InvokeAsync();
            }
        }
        catch (VaultTokenRefusedException ex)
        {
            TokenCache.Clear();
            token = null;
            error = $"{ex.Message} Paste a new token, or ask for a policy that allows writing under the namespace.";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ToggleOrphan(string path, bool selected)
    {
        if (selected)
            selectedOrphans.Add(path);
        else
            selectedOrphans.Remove(path);
        confirmingRemoval = false;
    }

    private void SelectAllOrphans()
    {
        if (selectedOrphans.Count == orphans.Count)
            selectedOrphans.Clear();
        else
            selectedOrphans.UnionWith(orphans.Select(o => o.Path));
        confirmingRemoval = false;
    }

    private async Task RemoveSelectedAsync()
    {
        isBusy = true;
        error = null;
        try
        {
            var usedToken = EffectiveToken!;
            var removal = await VaultExport.RemoveOrphansAsync(trustDomainId, usedToken, selectedOrphans.ToList());
            TokenCache.Save(usedToken);
            token = null;
            removedOrphans.AddRange(removal.Removed);
            removalFailures = removal.Failures.ToList();
            orphans.RemoveAll(o => removal.Removed.Contains(o.Path));
            selectedOrphans.ExceptWith(removal.Removed);
            if (removal.Removed.Count > 0)
                ToastService.ShowSuccess($"Removed {removal.Removed.Count} {(removal.Removed.Count == 1 ? "secret" : "secrets")} from Vault.");
        }
        catch (VaultTokenRefusedException ex)
        {
            TokenCache.Clear();
            token = null;
            error = $"{ex.Message} Paste a new token, or ask for a policy that allows deleting under the namespace.";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            error = ex.Message;
        }
        finally
        {
            confirmingRemoval = false;
            isBusy = false;
        }
    }

    private void ForgetToken()
    {
        TokenCache.Clear();
        listedNamespaces = null;
    }
}
